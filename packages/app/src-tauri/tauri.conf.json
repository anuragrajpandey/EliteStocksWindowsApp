{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ynoTV",
  "version": "2.4.0",
  "identifier": "com.ynotv.app",

  "build": {
    "beforeDevCommand": "pnpm --filter @ynotv/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ynotv/ui build",
    "frontendDist": "../../ui/dist"
  },

  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,

    "windows": [
      {
        "title": "ynoTV",
        "width": 1920,
        "height": 1080,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "pubkey": "",
      "endpoints": []
    }
  },

  "bundle": {
    "active": true,

    "createUpdaterArtifacts": false,

    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "dmg"
    ],

    "licenseFile": "../../../LICENSE",

    "externalBin": [
      "bin/mpv",
      "bin/ffmpeg",
      "bin/yt-dlp"
    ],

    "resources": {},

    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
